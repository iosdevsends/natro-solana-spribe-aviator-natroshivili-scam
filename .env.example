# ─── App identity ────────────────────────────────────────────────────────────
APP_NAME=natro-platform
COMPOSE_PROJECT_NAME=natro

# ─── Hosts / public URLs (change for prod) ──────────────────────────────────
PUBLIC_FRONTEND_URL=http://localhost:3000
PUBLIC_STRAPI_URL=http://localhost:1337

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=natro
POSTGRES_USER=natro
POSTGRES_PASSWORD=changeme_natro_pg

# ─── Strapi (backend) ────────────────────────────────────────────────────────
STRAPI_HOST=0.0.0.0
STRAPI_PORT=1337
NODE_ENV=development

# Generate via: openssl rand -base64 32
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=changeme_api_token_salt
ADMIN_JWT_SECRET=changeme_admin_jwt_secret
TRANSFER_TOKEN_SALT=changeme_transfer_token_salt
JWT_SECRET=changeme_jwt_secret
ENCRYPTION_KEY=changeme_encryption_key

DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=natro
DATABASE_USERNAME=natro
DATABASE_PASSWORD=changeme_natro_pg
DATABASE_SSL=false

# ─── Frontend (Next.js) ─────────────────────────────────────────────────────
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Locales the site supports (comma-separated)
NEXT_PUBLIC_LOCALES=en,ru,uk,ka,fr,de,es

# Google Analytics 4 measurement ID (leave blank to disable)
NEXT_PUBLIC_GA_ID=

# Google Search Console verification (paste the `content=...` value from the
# HTML-tag verification method). Leave blank when verified via DNS — the
# domain-wide DNS method (Cloudflare TXT) covers everything and makes this
# meta tag redundant. natro.meme is currently verified via Cloudflare DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Yandex.Webmaster verification (needed for the Russian search market — Google
# alone does not feed Yandex). Sign up at webmaster.yandex.com, choose
# "HTML meta-tag" verification, paste the `content=...` value here.
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Bing Webmaster Tools verification. Bing also covers DuckDuckGo / Ecosia
# search surfaces. Get the value from www.bing.com/webmasters meta-tag
# verification — it's the `content=` value of the `msvalidate.01` tag.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# IndexNow API key (Bing + Yandex + Yep). The deploy workflow pings IndexNow
# after each successful deploy so the search engines learn about new content
# within minutes instead of weeks. The key must match the filename of the
# {KEY}.txt file in frontend/public/ (the file's contents are the same key).
# Default works out of the box; regenerate with `openssl rand -hex 16` if
# rotating. Set INDEXNOW_KEY as a repo secret to override.
INDEXNOW_KEY=a28fa24b302f5e5a7dd9d9014798221f

# ─── Cloudflare Turnstile (CAPTCHA on register + submit forms) ──────────────
# Get from: dash.cloudflare.com → Turnstile → Add site (managed challenge).
# Leave both blank to disable the CAPTCHA gate (auth + submit still work).
NEXT_PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# ─── Comment wall (/reputation) moderation ──────────────────────────────────
# MODERATION_SECRET is the single shared editor passphrase that unlocks the
# comment-moderation admin at /admin/comments. Leave blank to keep the admin
# closed (no one can sign in). Choose a long random string.
MODERATION_SECRET=
# Salt for the one-way hash of commenter IPs (abuse/rate-limit forensics only;
# raw IPs are never stored). Any long random string; changing it resets the
# per-IP rate-limit window.
IP_HASH_SALT=

# ─── SMTP for Strapi email confirmation + password reset (Resend) ───────────
# Get from: resend.com → API Keys → Create. Use SMTP credentials:
#   host=smtp.resend.com  port=465  user=resend  password=<your-api-key>
# Verify your sending domain (natro.meme) in Resend DNS first.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=
EMAIL_FROM=noreply@natro.meme
EMAIL_FROM_NAME=The NATRO File
EMAIL_REPLY_TO=
# If empty, email confirmation is auto-disabled at bootstrap (so accounts work
# locally without SMTP).
EMAIL_CONFIRMATION_REQUIRED=false
