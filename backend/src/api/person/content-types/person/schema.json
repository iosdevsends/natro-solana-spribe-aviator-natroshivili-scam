{
  "kind": "collectionType",
  "collectionName": "people",
  "info": {
    "singularName": "person",
    "pluralName": "people",
    "displayName": "Person",
    "description": "A named party (§V). Self-doxxed via the launch marketing."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "fullName",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "order": {
      "type": "integer",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "fullName": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "displayName": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "role": {
      "type": "string",
      "description": "e.g. 'Founder / front man', 'Family principal'",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "handles": {
      "type": "json",
      "description": "Array of {platform, handle, url, followers, verified}",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "description": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "statement": {
      "type": "text",
      "description": "Direct attributed statement (italicized in render)",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "statementLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "exhibits": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::exhibit.exhibit",
      "pluginOptions": { "i18n": { "localized": false } }
    }
  }
}
